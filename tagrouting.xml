<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_TAGROUTING</name>
    <author>SuperSoft</author>
    <creationDate>2026-08</creationDate>
    <copyright>(C) 2026 SuperSoft</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>2.1.0</version>
    <description>PLG_SYSTEM_TAGROUTING_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\System\TagRouting</namespace>
    <files>
        <folder plugin="tagrouting">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>README.md</filename>
    </files>
    <config>
        <fields name="params">
            <fieldset name="routing_features" label="PLG_SYSTEM_TAGROUTING_FIELDSET_ROUTING_FEATURES">
                <field
                    name="enable_cleanup"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_hierarchical"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="tag_url_prefix"
                    type="text"
                    default="tags"
                    filter="cmd"
                    showon="enable_hierarchical:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_TAG_PREFIX_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_TAG_PREFIX_DESC"
                />
                <field
                    name="enable_faceted"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
