<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_TAGROUTING</name>
    <author>SuperSoft — Kontarinis Andreas</author>
    <creationDate>2026-09</creationDate>
    <copyright>© 2026 SuperSoft — Kontarinis Andreas</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>4.0.6</version>
    <description>PLG_SYSTEM_TAGROUTING_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\System\TagRouting</namespace>
    <files>
        <folder plugin="tagrouting">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="enable_cleanup"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="enable_hierarchical"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="enable_faceted"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="accepted_markers"
                    type="checkboxes"
                    multiple="true"
                    checkedOptions="!,!tag,!filter"
                    showon="enable_hierarchical:1[OR]enable_faceted:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_ACCEPTED_MARKERS_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_ACCEPTED_MARKERS_DESC"
                >
                    <option value="!">PLG_SYSTEM_TAGROUTING_MARKER_SHORT</option>
                    <option value="!tag">PLG_SYSTEM_TAGROUTING_MARKER_TAG</option>
                    <option value="!filter">PLG_SYSTEM_TAGROUTING_MARKER_FILTER</option>
                </field>
                <field
                    name="enable_custom_marker"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    showon="enable_hierarchical:1[OR]enable_faceted:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_ENABLE_CUSTOM_MARKER_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_ENABLE_CUSTOM_MARKER_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="custom_marker"
                    type="text"
                    default=""
                    filter="raw"
                    showon="enable_custom_marker:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_CUSTOM_MARKER_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_CUSTOM_MARKER_DESC"
                />
                <field
                    name="canonical_marker"
                    type="list"
                    default="!"
                    showon="enable_hierarchical:1[OR]enable_faceted:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_CANONICAL_MARKER_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_CANONICAL_MARKER_DESC"
                >
                    <option value="!">PLG_SYSTEM_TAGROUTING_MARKER_SHORT</option>
                    <option value="!tag">PLG_SYSTEM_TAGROUTING_MARKER_TAG</option>
                    <option value="!filter">PLG_SYSTEM_TAGROUTING_MARKER_FILTER</option>
                    <option value="__custom__">PLG_SYSTEM_TAGROUTING_MARKER_CUSTOM</option>
                </field>
                <field
                    name="show_breadcrumb_marker"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    showon="enable_hierarchical:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_SHOW_BREADCRUMB_MARKER_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_SHOW_BREADCRUMB_MARKER_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="breadcrumb_marker"
                    type="text"
                    default="#"
                    filter="raw"
                    showon="enable_hierarchical:1[AND]show_breadcrumb_marker:1"
                    label="PLG_SYSTEM_TAGROUTING_FIELD_BREADCRUMB_MARKER_LABEL"
                    description="PLG_SYSTEM_TAGROUTING_FIELD_BREADCRUMB_MARKER_DESC"
                />
            </fieldset>
        </fields>
    </config>
</extension>
