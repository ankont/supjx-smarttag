<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_TAGROUTING</name>
    <author>SuperSoft — Kontarinis Andreas</author>
    <creationDate>2026-09</creationDate>
    <copyright>© 2026 SuperSoft — Kontarinis Andreas</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>5.4.0</version>
    <description>PLG_SYSTEM_TAGROUTING_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\System\TagRouting</namespace>
    <files>
        <folder plugin="tagrouting">services</folder>
        <folder>src</folder>
        <folder>forms</folder>
        <folder>language</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldprefix="SuperSoft\Plugin\System\TagRouting\Field">
                <field name="enable_cleanup" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_CLEANUP_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="enable_hierarchical" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_HIERARCHICAL_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="enable_faceted" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_FACETED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="facet_scope" type="list" default="category" showon="enable_faceted:1" label="PLG_SYSTEM_TAGROUTING_FACET_SCOPE_LABEL" description="PLG_SYSTEM_TAGROUTING_FACET_SCOPE_DESC">
                    <option value="category">PLG_SYSTEM_TAGROUTING_SCOPE_CATEGORY</option>
                    <option value="inherited">PLG_SYSTEM_TAGROUTING_SCOPE_INHERITED</option>
                    <option value="all">PLG_SYSTEM_TAGROUTING_SCOPE_ALL</option>
                </field>
                <field name="facet_include_descendants" type="radio" layout="joomla.form.field.radio.switcher" default="0" showon="enable_faceted:1[OR]enable_hierarchical:1" label="PLG_SYSTEM_TAGROUTING_DESCENDANTS_LABEL" description="PLG_SYSTEM_TAGROUTING_DESCENDANTS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="facet_max_groups" type="number" default="10" min="1" max="16" filter="integer" showon="enable_faceted:1[OR]enable_hierarchical:1" label="PLG_SYSTEM_TAGROUTING_MAX_GROUPS_LABEL" description="PLG_SYSTEM_TAGROUTING_MAX_GROUPS_DESC" />
                <field name="facet_max_or_options" type="number" default="10" min="1" max="32" filter="integer" showon="enable_faceted:1[OR]enable_hierarchical:1" label="PLG_SYSTEM_TAGROUTING_MAX_OR_LABEL" description="PLG_SYSTEM_TAGROUTING_MAX_OR_DESC" />
                <field name="facet_max_options" type="number" default="15" min="1" max="512" filter="integer" showon="enable_faceted:1[OR]enable_hierarchical:1" label="PLG_SYSTEM_TAGROUTING_MAX_OPTIONS_LABEL" description="PLG_SYSTEM_TAGROUTING_MAX_OPTIONS_DESC" />
                <field name="facet_max_bytes" type="number" default="1024" min="1" max="2048" filter="integer" showon="enable_faceted:1[OR]enable_hierarchical:1" label="PLG_SYSTEM_TAGROUTING_MAX_BYTES_LABEL" description="PLG_SYSTEM_TAGROUTING_MAX_BYTES_DESC" />
                <field name="accepted_markers" type="MarkerControls" multiple="true" showon="enable_hierarchical:1[OR]enable_faceted:1" label="PLG_SYSTEM_TAGROUTING_FIELD_ACCEPTED_MARKERS_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_ACCEPTED_MARKERS_DESC" filter="array" default="!,!tag,!filter">
                </field>
                <field name="custom_marker" type="text" default="" hint="!example" filter="raw" label="PLG_SYSTEM_TAGROUTING_FIELD_CUSTOM_MARKER_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_CUSTOM_MARKER_DESC" size="12" class="input-small" showon="params.accepted_markers.custom_enabled:1" />
                <field name="canonical_marker" type="list" default="!" showon="enable_hierarchical:1[OR]enable_faceted:1" label="PLG_SYSTEM_TAGROUTING_FIELD_CANONICAL_MARKER_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_CANONICAL_MARKER_DESC">
                    <option value="!">PLG_SYSTEM_TAGROUTING_MARKER_SHORT</option>
                    <option value="!tag">PLG_SYSTEM_TAGROUTING_MARKER_TAG</option>
                    <option value="!filter">PLG_SYSTEM_TAGROUTING_MARKER_FILTER</option>
                    <option value="__custom__">PLG_SYSTEM_TAGROUTING_MARKER_CUSTOM</option>
                </field>
                <field name="show_breadcrumb_marker" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_TAGROUTING_FIELD_SHOW_BREADCRUMB_MARKER_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_SHOW_BREADCRUMB_MARKER_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="breadcrumb_marker" type="text" default="" hint="#" filter="raw" showon="show_breadcrumb_marker:1" label="PLG_SYSTEM_TAGROUTING_FIELD_BREADCRUMB_MARKER_LABEL" description="PLG_SYSTEM_TAGROUTING_FIELD_BREADCRUMB_MARKER_DESC" />
        <field name="breadcrumb_marker_placement" type="list" default="separate" filter="cmd" showon="show_breadcrumb_marker:1" label="PLG_SYSTEM_TAGROUTING_MARKER_PLACEMENT">
            <option value="separate">PLG_SYSTEM_TAGROUTING_MARKER_SEPARATE</option>
            <option value="inline">PLG_SYSTEM_TAGROUTING_MARKER_INLINE</option>
        </field>
                <field name="enable_custom_marker" type="hidden" filter="integer" default="0" />
            </fieldset>
            <fieldset name="howto" label="PLG_SYSTEM_TAGROUTING_HELP_TAB">
                <field name="routing_help" type="note" class="" description="PLG_SYSTEM_TAGROUTING_HELP_OVERVIEW" filter="unset" />
            </fieldset>
        </fields>
    </config>
</extension>
