<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_SMARTTAGENHANCEMENTS</name>
    <author>SuperSoft - Kontarinis Andreas</author>
    <creationDate>2026-11</creationDate>
    <copyright>Copyright (C) 2026 SuperSoft</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.2.0</version>
    <description>PLG_SYSTEM_SMARTTAGENHANCEMENTS_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\System\SmartTagEnhancements</namespace>
    <files>
        <folder plugin="smarttagenhancements">services</folder>
        <folder>src</folder>
        <folder>layouts</folder>
        <folder>language</folder>
    </files>
    <media destination="plg_system_smarttagenhancements" folder="media">
        <folder>js</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic" label="JOPTIONS">
                <field name="enable_frontend_editing" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_SYSTEM_SMARTTAGENHANCEMENTS_FRONTEND_LABEL" description="PLG_SYSTEM_SMARTTAGENHANCEMENTS_FRONTEND_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="enable_custom_fields" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer" label="PLG_SYSTEM_SMARTTAGENHANCEMENTS_CUSTOM_FIELDS_LABEL" description="PLG_SYSTEM_SMARTTAGENHANCEMENTS_CUSTOM_FIELDS_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
